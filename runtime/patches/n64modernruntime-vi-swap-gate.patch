+// adam: swap gate (see set_swap_gate). At each osViSwapBuffer the game's in-flight graphics task count is recorded for
+// that framebuffer; it's fully drawn once that many graphics tasks have been completed since. Tasks submitted after the
+// swap request don't count (the game may hold the next frame's tasks until the swap happened).
+static uint32_t (*swap_pending_tasks)() = nullptr;
+static std::atomic<uint64_t> gfx_tasks_done = 0;
+static std::pair<PTR(void), uint64_t> swap_needed[4] = {}; // framebuffer -> gfx_tasks_done value when it's fully drawn
+static uint32_t swap_needed_next = 0;
+static ultramodern::renderer::ViRegs last_presented{}; // VI thread only
+static bool have_presented = false;
+static uint32_t held_vis = 0;
+static std::atomic<bool> swap_gate_always = false;
+
+void ultramodern::set_swap_gate_always(bool always) {
+    swap_gate_always = always;
+}
+
+static std::atomic<bool> frame_log_on = false;
+static std::mutex frame_log_mutex;
+static std::vector<ultramodern::FrameLogEntry> frame_log_entries;
+
+static void frame_log(char kind, uint32_t a, uint32_t b = 0, uint32_t c = 0, uint32_t d = 0) {
+    if (!frame_log_on.load(std::memory_order_relaxed)) {
+        return;
+    }
+    uint64_t us = (uint64_t)std::chrono::duration_cast<std::chrono::microseconds>(
+        std::chrono::high_resolution_clock::now() - ultramodern::get_start()).count();
+    std::lock_guard lock{ frame_log_mutex };
+    if (frame_log_entries.size() < 400000) {
+        frame_log_entries.push_back({ us, kind, a, b, c, d });
+    }
+}
+
+void ultramodern::frame_log_enable(bool enable) {
+    frame_log_on = enable;
+}
+
+std::vector<ultramodern::FrameLogEntry> ultramodern::frame_log_take() {
+    std::lock_guard lock{ frame_log_mutex };
+    std::vector<ultramodern::FrameLogEntry> out;
+    out.swap(frame_log_entries);
+    return out;
+}
+
+void ultramodern::set_swap_gate(uint32_t (*pending_tasks)()) {
+    swap_pending_tasks = pending_tasks;
+}

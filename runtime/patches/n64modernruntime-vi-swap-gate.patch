+        // adam: while fast-forwarding (or always, if set), keep showing the current framebuffer until the swapped-in one
+        // is fully drawn, for at most one normal-speed VI (vi_multiplier VIs), so a miscount can never hold the game.
+        PTR(void) deferred_framebuffer = NULLPTR;
+        {
+            std::lock_guard lock{ events_context.message_mutex };
+            ViState* next_state = events_context.vi.get_next_state();
+            ViState* cur_state = events_context.vi.get_cur_state();
+            if ((vi_multiplier > 1 || swap_gate_always.load()) && swap_pending_tasks != nullptr && ultramodern::is_game_started() &&
+                next_state->framebuffer != cur_state->framebuffer && gfx_tasks_done.load() < swap_tasks_needed &&
+                deferred_vis < vi_multiplier) {
+                deferred_framebuffer = next_state->framebuffer;
+                next_state->framebuffer = cur_state->framebuffer;
+                deferred_vis++;
+            } else {
+                deferred_vis = 0;
+            }
+            events_context.vi.update_vi();
+            if (deferred_framebuffer != NULLPTR) {
+                // Still the next framebuffer (osViGetNextFramebuffer reports it, as on hardware while a swap is pending).
+                events_context.vi.get_next_state()->framebuffer = deferred_framebuffer;
+            }
+        }
 

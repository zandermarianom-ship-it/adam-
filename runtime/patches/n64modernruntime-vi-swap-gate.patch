+// adam: swap gate (see set_swap_gate). At each osViSwapBuffer the game's in-flight graphics task count is recorded;
+// the swap is ready once that many graphics tasks have been completed since. Tasks submitted after the swap request
+// don't count (the game may hold the next frame's tasks until the swap happened).
+static uint32_t (*swap_pending_tasks)() = nullptr;
+static std::atomic<uint64_t> gfx_tasks_done = 0;
+static uint64_t swap_tasks_needed = 0; // gfx_tasks_done value at which the requested swap is fully drawn
+static uint32_t deferred_vis = 0; // VIs the current swap has been held back (VI thread only)
+
+void ultramodern::set_swap_gate(uint32_t (*pending_tasks)()) {
+    swap_pending_tasks = pending_tasks;
+}
+
+static std::atomic<bool> swap_gate_always = false;
+
+void ultramodern::set_swap_gate_always(bool always) {
+    swap_gate_always = always;
+}

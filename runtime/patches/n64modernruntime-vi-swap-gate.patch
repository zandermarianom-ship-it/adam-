+// adam: the picture shows a framebuffer only once the graphics tasks that were in flight when the game swapped to it
+// (pending_tasks() = the game's own count at that moment) are done; until then, for at most a few VIs, the last fully
+// drawn one stays on screen. Only the picture: the game's VI state and timing aren't changed. Always while
+// fast-forwarding (else at 4x+ the HUD went missing or frames went black), at normal speed with
+// set_swap_gate_always(true) (else the 3D scenes flickered on some PCs).
+void set_swap_gate(uint32_t (*pending_tasks)());
+void set_swap_gate_always(bool always);
+// adam: frame log for finding display problems (main.cpp's F8): graphics tasks submitted / started / finished,
+// framebuffer swaps and what each VI put on screen, with times. Recorded only while enabled.
+struct FrameLogEntry {
+    uint64_t us;    // microseconds since the game started
+    char kind;      // 'T' gfx task submitted, 'S' started, 'E' finished, 'W' osViSwapBuffer, 'V' VI screen update
+    uint32_t a, b, c, d;
+};
+void frame_log_enable(bool enable);
+std::vector<FrameLogEntry> frame_log_take();
 

diff --git a/src/gbi/rt64_gbi_rdp.cpp b/src/gbi/rt64_gbi_rdp.cpp
index 6255872..73980b8 100644
--- a/src/gbi/rt64_gbi_rdp.cpp
+++ b/src/gbi/rt64_gbi_rdp.cpp
@@ -254,6 +254,13 @@ namespace RT64 {
 
         void fullSync(State *state, DisplayList **dl) {
             RT64_LOG_PRINTF("GBI_RDP::fullSync()");
+            if (state->deferFullSync) {
+                // adam: the frame goes on in the next display list (see State::deferFullSync).
+                state->flush();
+                state->dpInterrupt();
+                return;
+            }
+
             state->fullSync();
             state->dpInterrupt();
         }
diff --git a/src/hle/rt64_state.h b/src/hle/rt64_state.h
index 4f10425..cd58639 100644
--- a/src/hle/rt64_state.h
+++ b/src/hle/rt64_state.h
@@ -159,6 +159,11 @@ namespace RT64 {
         void submitFramebufferPair(FramebufferPair::FlushReason flushReason);
         void checkRDRAM();
         void fullSync();
+
+        // adam: while set, a display list's full sync doesn't end the workload: the next display list (the game's
+        // next graphics task of the same frame) is drawn into it too, so a frame made of several tasks is matched and
+        // interpolated as one. The host clears it for the frame's last task.
+        bool deferFullSync = false;
         void fullSyncFramebufferPairTiles(Workload &workload, FramebufferPair &fbPair, uint32_t &loadOpCursor, uint32_t &rdpTileCursor);
         void listProcessBegin();

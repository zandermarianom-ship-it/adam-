         void fullSync(State *state, DisplayList **dl) {
             RT64_LOG_PRINTF("GBI_RDP::fullSync()");
+            if (state->deferFullSync) {
+                // adam: the frame goes on in the next display list (see State::deferFullSync).
+                state->flush();
+                state->dpInterrupt();
+                return;
+            }
+
             state->fullSync();
             state->dpInterrupt();
         }
